{
  "name": "@preptex/core",
  "version": "0.2.1",
  "description": "Environment-neutral TypeScript library for parsing and transforming virtual LaTeX projects.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/preptex/preptex-core.git"
  },
  "bugs": {
    "url": "https://github.com/preptex/preptex-core/issues"
  },
  "homepage": "https://github.com/preptex/preptex-core#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-test": "npm run build && tsc -p tsconfig.type-tests.json",
    "docs": "typedoc --options typedoc.json",
    "docs:check": "typedoc --options typedoc.json --emit none",
    "prepack": "npm run clean && npm run build && node -e \"require('node:fs').cpSync('../docs', 'dist/docs', {recursive: true})\""
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.2.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
